# PaveDB sample configuration
# Generated from pave.config.CONFIG_FIELDS.
# Regenerate with: make docs-refresh
#
# Config file location override:
#   PAVEDB_CONFIG=/etc/pavedb/config.yml
#
# Every config key can also be overridden with an environment variable.
# Nested keys use double underscores, for example:
#   PAVEDB_AUTH__MODE=static
#   PAVEDB_LOG__LEVEL=debug
#
# Tenant sidecar precedence:
#   env vars > config.yml > tenants.yml > defaults

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Root directory for local catalog, metadata, document chunks, and indexes. When omitted
# at runtime, defaults to the instance home data directory.
# Env: PAVEDB_DATA_DIR
data_dir: '~/pavedb/data'

# Allow searches to include the configured common collection when requested.
# Env: PAVEDB_COMMON_ENABLED
common_enabled: false

# Tenant that owns the common collection.
# Env: PAVEDB_COMMON_TENANT
common_tenant: 'global'

# Collection name used for common shared results.
# Env: PAVEDB_COMMON_COLLECTION
common_collection: 'common'

# Enable development startup behavior such as allowing auth.mode=none on loopback and
# verbose PaveDB logging.
# Env: PAVEDB_DEV
dev: false


# ---------------------------------------------------------------------------
# Query Log
# ---------------------------------------------------------------------------

query_log:

  # Enable persisted query history and query-home lookup pointers.
  # Env: PAVEDB_QUERY_LOG__ENABLED
  # enabled: true


# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------

cache:

  # Max open collection backend and metadata handles; values below 1 become 1.
  # Env: PAVEDB_CACHE__COLLECTION_MAX
  collection_max: 64

  # Max runtime embedder instances in the hot cache; active collections stay pinned.
  # Env: PAVEDB_CACHE__EMBEDDER_MAX
  embedder_max: 32


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

auth:

  # Authentication mode. Use static outside dev; none is accepted only under the startup
  # policy's dev safeguards.
  # Env: PAVEDB_AUTH__MODE
  mode: 'static'

  # Tenant label assigned to unauthenticated requests when auth.mode is none.
  # Env: PAVEDB_AUTH__DEFAULT_ACCESS_TENANT
  default_access_tenant: 'public'

  # Admin bearer token. Server startup generates admin.key when omitted.
  # Env: PAVEDB_AUTH__GLOBAL_KEY
  # global_key: null

  # Map of tenant name to bearer token when auth.mode is static.
  # Env: PAVEDB_AUTH__API_KEYS
  api_keys: {}

  # Optional sidecar YAML file containing auth.api_keys and tenants.* values.
  # Env: PAVEDB_AUTH__TENANTS_FILE
  # tenants_file: null


# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------

vector_store:

  # Vector store backend used for local indexes.
  # Env: PAVEDB_VECTOR_STORE__TYPE
  type: 'faiss'


# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------

embedder:

  # Default embedder selector. Use a user-defined instance key, type, type:model, or
  # full vector key. Required when more than one embedder instance is configured.
  # Env: PAVEDB_EMBEDDER__DEFAULT
  # default: null

  # Warm the default embedder at server startup before the first query. Null uses the
  # startup policy: enabled outside dev, disabled in dev.
  # Env: PAVEDB_EMBEDDER__WARMUP_DEFAULT
  # warmup_default: false

  instances:

    native:

      # Built-in native embedder instance type. Native means PaveDB runs the embedder
      # itself rather than calling an external service.
      # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__TYPE
      type: 'sbert'

      # Default sentence-transformers model for the native instance.
      # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__MODEL
      model: 'sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'

      config:

        # Native SBERT runtime mode: auto, process, or direct. On macOS with FAISS, auto
        # selects process; direct is blocked.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__RUNTIME
        runtime: 'auto'

        # Optional native SBERT device override; cpu | cuda | mps | auto lets the
        # adapter choose.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__DEVICE
        device: 'auto'

        # Optional native SBERT encode batch size; null uses the adapter default.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__BATCH_SIZE
        # batch_size: null

        # Native SBERT process worker count; auto picks a conservative local default
        # capped for mixed search/ingest tail stability.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__WORKERS
        workers: 'auto'

    #
    # Additional instance examples. Keep these commented until the
    # provider is configured. If more than one instance is active, set
    # embedder.default above to an instance key or vector-space selector.
    #
    # Credentials live on the instance as a sibling of 'config' (never
    # inside it): 'api_key' is a secret and must not enter the vector-
    # space config. Reference an env var with ${VAR} so the secret stays
    # out of this file; each instance can carry its own key, so you can
    # point several instances at the same provider with different
    # credentials. If 'api_key' is omitted for an openai instance, the
    # OpenAI SDK falls back to the OPENAI_API_KEY environment variable.
    #
    # Global per-type fallback: 'embedder.<type>.<field>' (e.g.
    # 'embedder.sbert.device: cuda' or 'embedder.openai.batch_size: 256')
    # sets a default 'config' value — plus 'model' — for every instance
    # of that type. An instance's own 'config' value overrides it.
    #
    # local-small:
    #   type: 'ollama'
    #   model: 'nomic-embed-text'
    #   config:
    #     dim: 768
    #     base_url: 'http://localhost:11434/v1'
    #
    # local-complex:
    #   type: 'ollama'
    #   model: 'bge-m3'
    #   config:
    #     dim: 1024
    #     base_url: 'http://localhost:11434/v1'
    #
    # frontier-affordable:
    #   type: 'openai'
    #   model: 'text-embedding-3-small'
    #   api_key: '${OPENAI_API_KEY_PRIMARY}'
    #   config:
    #     dim: 1536
    #     batch_size: 256
    #     # base_url: '${PAVEDB_OPENAI_BASE_URL}'
    #
    # frontier-secondary:
    #   type: 'openai'
    #   model: 'text-embedding-3-large'
    #   api_key: '${OPENAI_API_KEY_SECONDARY}'
    #   config:
    #     dim: 3072


# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------

ingest:

  # Reject document uploads larger than this many megabytes; 0 disables the limit.
  # Env: PAVEDB_INGEST__MAX_FILE_SIZE_MB
  max_file_size_mb: 500

  # Maximum number of concurrent ingest operations; 0 disables the cap.
  # Env: PAVEDB_INGEST__MAX_CONCURRENT
  max_concurrent: 7


# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

search:

  # Maximum number of concurrent search operations; 0 disables the cap.
  # Env: PAVEDB_SEARCH__MAX_CONCURRENT
  max_concurrent: 42

  # Per-search timeout in milliseconds; 0 disables the timeout.
  # Env: PAVEDB_SEARCH__TIMEOUT_MS
  timeout_ms: 30000


# ---------------------------------------------------------------------------
# Text Preprocessing
# ---------------------------------------------------------------------------

preprocess:

  # Plain-text chunk size in characters.
  # Env: PAVEDB_PREPROCESS__TXT_CHUNK_SIZE
  txt_chunk_size: 1000

  # Plain-text chunk overlap in characters.
  # Env: PAVEDB_PREPROCESS__TXT_CHUNK_OVERLAP
  txt_chunk_overlap: 200


# ---------------------------------------------------------------------------
# Tenants
# ---------------------------------------------------------------------------

tenants:

  # Default per-tenant concurrent request cap; 0 disables the cap.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_CONCURRENT
  default_max_concurrent: 42


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

server:

  # Default server bind host after startup policy enforcement.
  # Env: PAVEDB_SERVER__HOST
  host: '127.0.0.1'

  # Default server bind port.
  # Env: PAVEDB_SERVER__PORT
  port: 8086

  # Enable uvicorn reload when running the packaged server.
  # Env: PAVEDB_SERVER__RELOAD
  reload: false

  # Number of uvicorn worker processes.
  # Env: PAVEDB_SERVER__WORKERS
  workers: 1

  # Uvicorn keep-alive timeout in seconds.
  # Env: PAVEDB_SERVER__TIMEOUT_KEEP_ALIVE
  timeout_keep_alive: 75


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log:

  # Base stderr log level.
  # Env: PAVEDB_LOG__LEVEL
  level: 'INFO'

  # Destination for structured operation logs: null/off, stdout, or a file path.
  # Env: PAVEDB_LOG__OPS_LOG
  # ops_log: null

  # Destination for uvicorn access logs: null/off, stdout, or a file path.
  # Env: PAVEDB_LOG__ACCESS_LOG
  # access_log: null

  # Logger namespaces forced to DEBUG level.
  # Env: PAVEDB_LOG__DEBUG
  debug: []

  # Logger namespaces made one level more verbose than the base log level.
  # Env: PAVEDB_LOG__WATCH
  watch: []

  # Noisy dependency logger namespaces made one level quieter than the base log level.
  # Env: PAVEDB_LOG__QUIET
  quiet: ['uvicorn', 'uvicorn.access', 'uvicorn.error', 'fastapi', 'sqlalchemy', 'urllib3', 'httpx']


# ---------------------------------------------------------------------------
# Instance
# ---------------------------------------------------------------------------

instance:

  # Display instance name used by the API metadata and UI.
  # Env: PAVEDB_INSTANCE__NAME
  # name: null

  # Description used by the API metadata and UI.
  # Env: PAVEDB_INSTANCE__DESC
  desc: 'Vector Search Microservice'
