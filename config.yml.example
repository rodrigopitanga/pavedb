# PaveDB sample configuration
# Generated from pave.config.CONFIG_FIELDS.
# Regenerate with: make docs-refresh
#
# Config file location override:
#   PAVEDB_CONFIG=/etc/pavedb/config.yml
#
# Every config key can also be overridden with an environment variable.
# Nested keys use double underscores, for example:
#   PAVEDB_AUTH__MODE=static
#   PAVEDB_LOG__LEVEL=debug
#
# Tenant sidecar precedence:
#   env vars > config.yml > tenants.yml > defaults

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Root directory for local catalog, metadata, document chunks, and indexes. When omitted
# at runtime, defaults to the instance home data directory.
# Env: PAVEDB_DATA_DIR
data_dir: '~/pavedb/data'

# Allow searches to include the configured common collection when requested.
# Env: PAVEDB_COMMON_ENABLED
common_enabled: false

# Tenant that owns the common collection.
# Env: PAVEDB_COMMON_TENANT
common_tenant: 'global'

# Collection name used for common shared results.
# Env: PAVEDB_COMMON_COLLECTION
common_collection: 'common'

# Enable development startup behavior such as allowing auth.mode=none on loopback and
# verbose PaveDB logging.
# Env: PAVEDB_DEV
dev: false


# ---------------------------------------------------------------------------
# Query Log
# ---------------------------------------------------------------------------

query_log:

  # Enable persisted query history and query-home lookup pointers.
  # Env: PAVEDB_QUERY_LOG__ENABLED
  # enabled: true


# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------

cache:

  # Max open collection backend and metadata handles; values below 1 become 1.
  # Env: PAVEDB_CACHE__COLLECTION_MAX
  collection_max: 64

  # Max runtime embedder instances in the hot cache; active collections stay pinned.
  # Env: PAVEDB_CACHE__EMBEDDER_MAX
  embedder_max: 32

archive:

  # Collection archive dumps/restores running at once on this instance; 0 disables the
  # bound. Archives read or rebuild a whole collection, so the default stays small.
  # Env: PAVEDB_ARCHIVE__MAX_CONCURRENT
  max_concurrent: 2

  # Collection archive operations one tenant may run at once; 0 disables the bound.
  # Env: PAVEDB_ARCHIVE__MAX_CONCURRENT_PER_TENANT
  max_concurrent_per_tenant: 1

reindex:

  # Reindex jobs running at once on this instance; 0 disables the bound. A reindex re-
  # embeds a whole collection.
  # Env: PAVEDB_REINDEX__MAX_CONCURRENT
  max_concurrent: 1

  # Reindex jobs one tenant may run at once; 0 disables the bound.
  # Env: PAVEDB_REINDEX__MAX_CONCURRENT_PER_TENANT
  max_concurrent_per_tenant: 1


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

auth:

  # Authentication mode. Use static outside dev; none is accepted only under the startup
  # policy's dev safeguards.
  # Env: PAVEDB_AUTH__MODE
  mode: 'static'

  # Tenant label assigned to unauthenticated requests when auth.mode is none. Tenant
  # names must match ^[a-z0-9][a-z0-9-]{0,62}$ (lowercase ASCII, digits and hyphen) --
  # the same rule as collection names. Lowercase-only keeps a name from colliding with
  # another under case folding or Unicode normalization on case-insensitive filesystems
  # (APFS, NTFS, SMB), where two such tenants would otherwise share one data directory.
  # Env: PAVEDB_AUTH__DEFAULT_ACCESS_TENANT
  default_access_tenant: 'public'

  # Admin bearer token. Server startup generates admin.key when omitted.
  # Env: PAVEDB_AUTH__GLOBAL_KEY
  # global_key: null

  # Map of tenant name to bearer token when auth.mode is static. Tenant names must match
  # ^[a-z0-9][a-z0-9-]{0,62}$ (lowercase ASCII, digits and hyphen) -- the same rule as
  # collection names. Lowercase-only keeps a name from colliding with another under case
  # folding or Unicode normalization on case-insensitive filesystems (APFS, NTFS, SMB),
  # where two such tenants would otherwise share one data directory. To revoke a
  # tenant's key, delete its entry from the tenants file, set a new value, or set it to
  # null in config.yml; null also removes a key that only the tenants file supplies.
  # Environment override names are case-folded and match an existing config key case-
  # insensitively.
  # Env: PAVEDB_AUTH__API_KEYS
  api_keys: {}

  # Optional sidecar YAML file containing auth.api_keys and tenants.* values.
  # Env: PAVEDB_AUTH__TENANTS_FILE
  # tenants_file: null


# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------

vector_store:

  # Vector store backend used for local indexes.
  # Env: PAVEDB_VECTOR_STORE__TYPE
  type: 'faiss'


# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------

embedder:

  # Default embedder selector. Use a user-defined instance key, type, type:model, or
  # full vector key. Required when more than one embedder instance is configured.
  # Env: PAVEDB_EMBEDDER__DEFAULT
  # default: null

  routing:

    # How each collection load chooses among configured instances in the same vector
    # space. First uses config order; round_robin rotates; weighted rotates by each
    # instance weight; failover tries in order until one initializes. Routing is
    # runtime-only and is never persisted in collection catalog state.
    # Env: PAVEDB_EMBEDDER__ROUTING__POLICY
    policy: 'first'

    priority:

      # Operator preference: one or more configured embedder instances (comma-separated
      # or a list) tried in order for this operation class (ingest); the first instance
      # sharing the collection's vector space runs it — one entry per model family.
      # Nothing compatible, or the preferred instance unable to serve, falls back to
      # embedder.routing.policy. Never a caller choice.
      # Env: PAVEDB_EMBEDDER__ROUTING__PRIORITY__INGEST
      # ingest: null

      # Operator preference: one or more configured embedder instances (comma-separated
      # or a list) tried in order for this operation class (search); the first instance
      # sharing the collection's vector space runs it — one entry per model family.
      # Nothing compatible, or the preferred instance unable to serve, falls back to
      # embedder.routing.policy. Never a caller choice.
      # Env: PAVEDB_EMBEDDER__ROUTING__PRIORITY__SEARCH
      # search: null

      # Operator preference: one or more configured embedder instances (comma-separated
      # or a list) tried in order for this operation class (maintenance); the first
      # instance sharing the collection's vector space runs it — one entry per model
      # family. Nothing compatible, or the preferred instance unable to serve, falls
      # back to embedder.routing.policy. Never a caller choice.
      # Env: PAVEDB_EMBEDDER__ROUTING__PRIORITY__MAINTENANCE
      # maintenance: null

  # Warm the default embedder at server startup before the first query. Null uses the
  # startup policy: enabled outside dev, disabled in dev.
  # Env: PAVEDB_EMBEDDER__WARMUP_DEFAULT
  # warmup_default: false

  instances:

    native:

      # Built-in native embedder instance type. Native means PaveDB runs the embedder
      # itself rather than calling an external service.
      # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__TYPE
      type: 'sbert'

      # Default sentence-transformers model for the native instance.
      # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__MODEL
      model: 'sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'

      # Positive routing weight for the native instance when embedder.routing.policy is
      # weighted. Custom instances accept the same sibling field.
      # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__WEIGHT
      weight: 1

      config:

        # Native SBERT runtime mode: auto, process, or direct. On macOS with FAISS, auto
        # selects process; direct is blocked.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__RUNTIME
        runtime: 'auto'

        # Optional native SBERT device override; cpu | cuda | mps | auto lets the
        # adapter choose.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__DEVICE
        device: 'auto'

        # Optional native SBERT encode batch size; null uses the adapter default.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__BATCH_SIZE
        # batch_size: null

        # Pass `trust_remote_code=True` to Sentence-Transformers when loading the model.
        # Required by models with custom architectures (for example `nomic-ai/nomic-
        # embed-text-v1.5`). Execution detail; not part of the vector-space identity,
        # and not inherited by a collection that names a different model.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__TRUST_REMOTE_CODE
        trust_remote_code: false

        # TEI-compatible `/embed` server used when `runtime` is `remote`. The remote
        # server must run the identical model in float32; the endpoint is not part of
        # the vector-space identity, so numerical equivalence with local runtimes is the
        # operator's contract.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__ENDPOINT
        # endpoint: null

        # Prefix prepended to query texts before encoding (e5-style `query: `). Changes
        # produced vectors and therefore participates in the vector-space identity.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__QUERY_PREFIX
        # query_prefix: null

        # Prefix prepended to passage texts before encoding (e5-style `passage: `).
        # Changes produced vectors and therefore participates in the vector-space
        # identity.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__PASSAGE_PREFIX
        # passage_prefix: null

        # Native SBERT process worker count; auto picks a conservative local default
        # capped for mixed search/ingest tail stability.
        # Env: PAVEDB_EMBEDDER__INSTANCES__NATIVE__CONFIG__WORKERS
        workers: 'auto'

    #
    # Additional instance examples. Keep these commented until the
    # provider is configured. If more than one instance is active, set
    # embedder.default above to an instance key or vector-space selector.
    #
    # Credentials live on the instance as a sibling of 'config' (never
    # inside it): 'api_key' is a secret and must not enter the vector-
    # space config. Reference an env var with ${VAR} so the secret stays
    # out of this file; each instance can carry its own key, so you can
    # point several instances at the same provider with different
    # credentials. If 'api_key' is omitted for an openai instance, the
    # OpenAI SDK falls back to the OPENAI_API_KEY environment variable.
    #
    # Global per-type fallback: 'embedder.<type>.<field>' (e.g.
    # 'embedder.sbert.device: cuda' or 'embedder.openai.batch_size: 256')
    # sets a default 'config' value — plus 'model' — for every instance
    # of that type. An instance's own 'config' value overrides it.
    #
    # OpenAI-compatible instances ('openai', 'ollama') also accept
    # 'timeout_s' in 'config': the total budget in seconds for one embed
    # request, SDK retries included (default 60). It bounds how long an
    # unresponsive provider can hold a worker slot; raise it for slow
    # local daemons that load a model on first use.
    # 'workers' bounds concurrent calls per instance; 'auto' (the default)
    # uses at most four clone-safe HTTP clients. Worker count is runtime-only
    # and never changes collection vector-space identity.
    #
    # local-small:
    #   type: 'ollama'
    #   model: 'nomic-embed-text'
    #   config:
    #     dim: 768
    #     base_url: 'http://localhost:11434/v1'
    #     workers: 'auto'
    #
    # local-complex:
    #   type: 'ollama'
    #   model: 'bge-m3'
    #   config:
    #     dim: 1024
    #     base_url: 'http://localhost:11434/v1'
    #
    # frontier-affordable:
    #   type: 'openai'
    #   model: 'text-embedding-3-small'
    #   api_key: '${OPENAI_API_KEY_PRIMARY}'
    #   config:
    #     dim: 1536
    #     batch_size: 256
    #     workers: 'auto'
    #     # base_url: '${PAVEDB_OPENAI_BASE_URL}'
    #
    # frontier-secondary:
    #   type: 'openai'
    #   model: 'text-embedding-3-large'
    #   api_key: '${OPENAI_API_KEY_SECONDARY}'
    #   config:
    #     dim: 3072


# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------

ingest:

  # Reject document uploads larger than this many megabytes; 0 disables the limit.
  # Env: PAVEDB_INGEST__MAX_FILE_SIZE_MB
  max_file_size_mb: 500

  # Reject a batch ingest request whose documents add up to more than this many
  # megabytes of text; null uses ingest.max_file_size_mb, 0 disables the limit.
  # Env: PAVEDB_INGEST__MAX_BATCH_SIZE_MB
  # max_batch_size_mb: null

  # Maximum number of concurrent ingest operations; 0 disables the cap.
  # Env: PAVEDB_INGEST__MAX_CONCURRENT
  max_concurrent: 7

  # Maximum share of ingest.max_concurrent that one tenant may hold. 0 (the default)
  # disables the share: any tenant may fill the whole ingest pool, which is what a
  # single-tenant instance wants. Set it on a shared instance, where one tenant filling
  # the pool starves every other. Note ingest.max_concurrent (7) is smaller than
  # tenants.default_max_concurrent (42), so the per-tenant request cap cannot bind on
  # ingest and this is the only per-tenant ingest bound.
  # Env: PAVEDB_INGEST__MAX_CONCURRENT_PER_TENANT
  max_concurrent_per_tenant: 0


# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

search:

  # Maximum number of concurrent search operations; 0 disables the cap.
  # Env: PAVEDB_SEARCH__MAX_CONCURRENT
  max_concurrent: 42

  # Maximum share of search.max_concurrent that one tenant may hold. 0 (the default)
  # disables the share: any tenant may fill the whole search pool, which is what a
  # single-tenant instance wants. Set it on a shared instance, where one tenant filling
  # the pool starves every other. Note search.max_concurrent (42) is not smaller than
  # tenants.default_max_concurrent (42), so the per-tenant request cap only binds once a
  # tenant already holds the entire pool. A search costs far less than an ingest, so
  # this share can be generous: about two thirds of the pool still leaves room for the
  # other tenants. A request over this share is refused with 503 search_overloaded; a
  # request over tenants.default_max_concurrent is refused earlier, with 429
  # tenant_rate_limited.
  # Env: PAVEDB_SEARCH__MAX_CONCURRENT_PER_TENANT
  max_concurrent_per_tenant: 0

  # Per-search timeout in milliseconds; 0 disables the timeout.
  # Env: PAVEDB_SEARCH__TIMEOUT_MS
  timeout_ms: 30000

  # Re-rank candidates already inside the vector fetch window by exact query-token
  # overlap with chunk text (P1-07). Off by default: it reads SQLite chunk text for
  # every candidate in the fetch window (max(50, 5*k) chunks, and more when metadata or
  # content filters make the window expand), not just the returned k, so enabling it
  # trades extra per-search database I/O for better lexical precision.
  # Env: PAVEDB_SEARCH__EXACT_TOKEN_BOOST
  exact_token_boost: false

  # Maximum score added when search.exact_token_boost is enabled and every query token
  # matches a chunk verbatim (casefolded); scaled by the fraction of query tokens
  # matched. 0, a negative number, or a non-numeric value disables the boost even if
  # search.exact_token_boost is true.
  # Env: PAVEDB_SEARCH__EXACT_TOKEN_BOOST_WEIGHT
  exact_token_boost_weight: 0.1


# ---------------------------------------------------------------------------
# Text Preprocessing
# ---------------------------------------------------------------------------

preprocess:

  # Plain-text chunk size in characters.
  # Env: PAVEDB_PREPROCESS__TXT_CHUNK_SIZE
  txt_chunk_size: 1000

  # Plain-text chunk overlap in characters.
  # Env: PAVEDB_PREPROCESS__TXT_CHUNK_OVERLAP
  txt_chunk_overlap: 200


# ---------------------------------------------------------------------------
# Tenants
# ---------------------------------------------------------------------------

tenants:

  # Default per-tenant concurrent request cap; 0 disables the cap.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_CONCURRENT
  default_max_concurrent: 42

  # Default moving-window request limit per tenant and minute; 0 disables the limit.
  # Per-tenant max_rpm in tenants.yml overrides it.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_RPM
  default_max_rpm: 0

  # Default moving-window request limit per tenant and hour; 0 disables the limit. Per-
  # tenant max_rph in tenants.yml overrides it.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_RPH
  default_max_rph: 0

  # Default per-tenant collection-count limit enforced at creation; 0 disables the cap.
  # Per-tenant max_collections in tenants.yml overrides it.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_COLLECTIONS
  default_max_collections: 0

  # Default cap on indexed chunks per collection enforced at ingest; 0 disables the cap.
  # Per-tenant max_chunks_per_collection in tenants.yml overrides it.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_CHUNKS_PER_COLLECTION
  default_max_chunks_per_collection: 0

  # Collection archive operations (dump or restore) a tenant may start per day; 0 =
  # unlimited. Override per tenant as tenants.<name>.max_archives_per_day. Charged on
  # the persistent per-operation rate window.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_ARCHIVES_PER_DAY
  default_max_archives_per_day: 0

  # Reindex jobs a tenant may start per 30 days; 0 = unlimited. Override per tenant as
  # tenants.<name>.max_reindex_per_month. Charged on the persistent per-operation rate
  # window.
  # Env: PAVEDB_TENANTS__DEFAULT_MAX_REINDEX_PER_MONTH
  default_max_reindex_per_month: 0


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

server:

  # Default server bind host after startup policy enforcement.
  # Env: PAVEDB_SERVER__HOST
  host: '127.0.0.1'

  # Default server bind port.
  # Env: PAVEDB_SERVER__PORT
  port: 8086

  # Enable uvicorn reload when running the packaged server.
  # Env: PAVEDB_SERVER__RELOAD
  reload: false

  # Number of Uvicorn worker processes launched by pavesrv. Values greater than 1 are
  # experimental, allowed only in dev mode, and may corrupt data; packaged production
  # startup rejects them.
  # Env: PAVEDB_SERVER__WORKERS
  workers: 1

  # Reject general request bodies above this many MB with 413 before routing or
  # authentication; 0 disables the cap. Documents use ingest.max_file_size_mb. Archive
  # restore authenticates before upload and is exempt.
  # Env: PAVEDB_SERVER__MAX_REQUEST_BODY_MB
  max_request_body_mb: 16

  # Uvicorn keep-alive timeout in seconds.
  # Env: PAVEDB_SERVER__TIMEOUT_KEEP_ALIVE
  timeout_keep_alive: 75

ui:

  # Serve the interactive OpenAPI/Swagger UI (the /ui bundle and FastAPI /docs, /redoc,
  # /openapi.json). Null uses the startup policy: enabled in dev, disabled in
  # production.
  # Env: PAVEDB_UI__ENABLED
  # enabled: null


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log:

  # Base stderr log level.
  # Env: PAVEDB_LOG__LEVEL
  level: 'INFO'

  # Destination for structured operation logs: null/off, stdout, or a file path. A new
  # file is created mode 0640 (its directory 0750) because every line names a tenant and
  # collection. PaveDB does not rotate it; rotate externally, e.g. logrotate with
  # copytruncate.
  # Env: PAVEDB_LOG__OPS_LOG
  # ops_log: null

  # Destination for uvicorn access logs: null/off, stdout, or a file path.
  # Env: PAVEDB_LOG__ACCESS_LOG
  # access_log: null

  # Logger namespaces forced to DEBUG level.
  # Env: PAVEDB_LOG__DEBUG
  debug: []

  # Logger namespaces made one level more verbose than the base log level.
  # Env: PAVEDB_LOG__WATCH
  watch: []

  # Noisy dependency logger namespaces made one level quieter than the base log level.
  # Env: PAVEDB_LOG__QUIET
  quiet: ['uvicorn', 'uvicorn.access', 'uvicorn.error', 'fastapi', 'sqlalchemy', 'urllib3', 'httpx']


# ---------------------------------------------------------------------------
# Instance
# ---------------------------------------------------------------------------

instance:

  # Display instance name used by the API metadata and UI.
  # Env: PAVEDB_INSTANCE__NAME
  # name: null

  # Description used by the API metadata and UI.
  # Env: PAVEDB_INSTANCE__DESC
  desc: 'Inspectable Retrieval Database'
