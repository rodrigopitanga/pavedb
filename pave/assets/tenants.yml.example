# Untracked secrets file with tenant API keys and per-tenant limits.
# Name it 'tenants.yml', adjust and DO NOT commit.
# The installed default should be innocuous; uncomment the examples you need.
#
# auth:
#   api_keys:
#     acme: change-me
#     umbrella: change-me

# Per-tenant request limits.
# Omit a setting to fall back to its tenants.default_* value in config.yml.
# -1 = unlimited for that tenant.
#
# tenants:
#   acme:
#     max_concurrent: 5   # overrides global default for acme; -1 = unlimited
#     max_rpm: 120        # moving-window requests per minute
#     max_rph: 5000       # moving-window requests per hour
#     max_collections: 10 # collection-count cap; overrides
#                         # tenants.default_max_collections; -1 = unlimited
#     max_chunks_per_collection: 100000 # indexed-chunk cap per collection;
#                         # overrides tenants.default_max_chunks_per_collection
#     max_chunks_per_tenant: 500000 # indexed-chunk ceiling across every
#                         # collection the tenant owns; overrides
#                         # tenants.default_max_chunks_per_tenant
#   umbrella:
#     max_concurrent: 20
