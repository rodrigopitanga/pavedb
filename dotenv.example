# PaveDB .env.example
# -------------------
# Copy to `.env` and fill only the section you need.
# Keep real secrets out of git.

# === Profile A: development (no auth) ====================
# No required variables.
# (Ensure config.yml sets auth.mode: none or use the default dev config.)

# === Profile B: production with static auth ==============
# PAVEDB_AUTH__MODE=static
# PAVEDB_AUTH__GLOBAL_KEY=change-me-strong-random-token

# === Optional: tenant keys via env =======================
# PAVEDB_AUTH__API_KEYS__acme=acme-secret
# PAVEDB_AUTH__API_KEYS__umbrella=umbrella-secret

# === Optional: override the default embedder =============
# PAVEDB_EMBEDDER__DEFAULT=native
# PAVEDB_EMBEDDER__INSTANCES__NATIVE__TYPE=sbert
# PAVEDB_EMBEDDER__INSTANCES__NATIVE__MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === Optional: explicit config and data paths ============
# PAVEDB_CONFIG=./config.yml
# PAVEDB_DATA_DIR=./data
